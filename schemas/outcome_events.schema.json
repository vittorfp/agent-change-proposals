{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-change-proposals.dev/schemas/outcome_events.schema.json",
  "title": "Outcome Events",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["run_id", "timestamp", "source", "label", "confidence"],
    "properties": {
      "run_id": { "type": "string" },
      "timestamp": { "type": "string" },
      "source": { "type": "string" },
      "label": { "enum": ["success", "failure", "mixed", "unknown"] },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "dimensions": {
        "type": "array",
        "items": { "type": "string" }
      },
      "notes": { "type": "string" }
    }
  }
}
