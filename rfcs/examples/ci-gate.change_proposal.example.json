  "hypothesis": {
    "summary": "The retrieval policy does not require retrieval for all policy-sensitive refund questions.",
    "confidence": "medium",
    "limits": "The evaluation set is intentionally narrow and should not be treated as full production coverage."
  },
  "proposed_change": {
    "target": {
      "target_id": "retrieval_policy.main",
      "type": "retrieval_policy",
      "component": "main_retriever",
      "description": "Rules that decide when external knowledge retrieval is required."
    },
    "summary": "Require retrieval before final answers for policy-sensitive refund questions.",
    "suggested_patch": {
      "require_retrieval_when": [
        "input mentions refund policy",
        "input asks for eligibility, credit, cancellation, or exception handling",
        "answer would make a policy-sensitive recommendation"
      ]
    }
  },
  "validation": {
